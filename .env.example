# Copy to .env and fill in. Never commit .env.
# GitHub: classic PAT with scopes repo + read:user
GITHUB_TOKEN=
GITHUB_USER=

# Optional. If set, every API call needs Authorization: Bearer <LIFE_TOKEN>
LIFE_TOKEN=

LIFE_PORT=7777
LIFE_TZ=Asia/Kolkata

# How far back the first GitHub sync reaches
GITHUB_SINCE_DAYS=400
